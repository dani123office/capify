# User uploads & render temp files (keep directory, ignore contents)
backend/storage/uploads/*
backend/storage/renders/*
backend/uploads/*
!backend/storage/uploads/.gitkeep
!backend/storage/renders/.gitkeep
!backend/uploads/.gitkeep

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS files
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Scratch
scratch/
temp/
tmp/
