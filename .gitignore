# Dependencies
node_modules/
.pnpm-store/
venv/
.venv/
env/

# Next.js build & dev outputs
.next/
frontend/.next/
frontend/node_modules/
out/
build/
dist/

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
